@'
# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# Local database files
*.db
*.sqlite3

# Temporary files
*.tmp
'@ | Set-Content -Encoding utf8 .gitignore